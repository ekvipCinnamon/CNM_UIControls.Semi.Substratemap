<div id="Desktop" data-tchmi-type="TcHmi.Controls.System.TcHmiView" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width-mode="Content" data-tchmi-min-width="100" data-tchmi-min-width-unit="%" data-tchmi-height-mode="Content" data-tchmi-min-height="100" data-tchmi-min-height-unit="%">
    <div id="ViewDesktopBeckhoffLogo" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-tchmi-src="Images/Beckhoff_Logo.svg" data-tchmi-left="20" data-tchmi-top="20" data-tchmi-width="194" data-tchmi-height="57">

    </div>
    <div id="SubstrateMap_1"
         data-tchmi-type="TcHmi.Controls.CNM_UIControls.SEMI.SubstrateMap"
         data-tchmi-aggregation-reducer="Auto"
         data-tchmi-height="1600"
         data-tchmi-height-unit="px"
         data-tchmi-left="1200"
         data-tchmi-left-unit="px"
         data-tchmi-top="195"
         data-tchmi-top-unit="px"
         data-tchmi-touch-target-size="0"
         data-tchmi-view-substrate-side="follow-map"
         data-tchmi-outline-preset="si-4in-p100"
         data-tchmi-grid-data="{ &quotdimension&quot: { &quotx&quot: 8, &quoty&quot: 8 }, &quotunits&quot: &quotmm&quot, &quotstepSize&quot: { &quotx&quot: 10, &quoty&quot: 10 }, &quotorientation&quot: 0, &quotoriginLocation&quot: &quotLowerLeft&quot, &quotaxisDirection&quot: &quotUpRight&quot, &quotbinType&quot: &quotAscii&quot, &quotnullBin&quot: &quot.&quot, &quotmapType&quot: &quot2DArray&quot, &quotbins&quot: [ &quot..1999..&quot, &quot..9999..&quot, &quot91999999&quot, &quot19919199&quot, &quot99999999&quot, &quot99999999&quot, &quot..1999..&quot, &quot..1991..&quot ], &quotbinDefinitions&quot: [ { &quotbinCode&quot: &quot1&quot, &quotbinQuality&quot: &quotPass&quot, &quotbinDescription&quot: &quotUnprocessed&quot }, { &quotbinCode&quot: &quot9&quot, &quotbinQuality&quot: &quotFail&quot, &quotbinDescription&quot: &quotFail&quot } ]}"
         data-tchmi-width="1740"
         data-tchmi-width-unit="px"
         data-tchmi-zindex="1">
    </div>

</div>
