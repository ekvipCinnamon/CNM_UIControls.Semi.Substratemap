{
  "$comment": "HAND-AUTHORED from v0211-coordinate-mixed.xml (Rule 10, D-030). MapType=Coordinate with @Number on every entry - the fourth BinCodeType attribute, carried and ignored for placement because no official example uses it to address anything. Seven entries on a 4x3 lattice, so five cells are unlisted and take the NullBin: a Coordinate map is SPARSE by construction and a reader that expected 12 entries would be wrong about the format rather than about the document.",
  "$format": "semi-e142", "$version": 1, "$namespace": "urn:semi-org:xsd.E142-1.V0211.SubstrateMap",
  "Layouts": [{ "LayoutId": "Coord", "DefaultUnits": "mm", "TopLevel": true,
    "Dimension": { "X": 4, "Y": 3 }, "StepSize": { "X": 1.0, "Y": 1.0 } }],
  "Substrates": [{ "SubstrateType": "Wafer", "SubstrateId": "COORDMIX01" }],
  "SubstrateMaps": [{
    "SubstrateType": "Wafer", "SubstrateId": "COORDMIX01", "LayoutSpecifier": "Coord",
    "Overlay": [{ "MapName": "Sort", "MapVersion": "1",
      "BinCodeMap": { "BinType": "Ascii", "NullBin": ".", "MapType": "Coordinate",
        "BinDefinitions": [{ "BinCode": "1", "BinDescription": "Pass" },
                           { "BinCode": "9", "BinDescription": "Fail" }],
        "BinCode": [
          { "X": 0, "Y": 0, "Number": 1, "$text": "1" },
          { "X": 1, "Y": 0, "Number": 2, "$text": "1" },
          { "X": 2, "Y": 0, "Number": 3, "$text": "9" },
          { "X": 0, "Y": 1, "Number": 4, "$text": "1" },
          { "X": 3, "Y": 1, "Number": 5, "$text": "1" },
          { "X": 1, "Y": 2, "Number": 6, "$text": "1" },
          { "X": 2, "Y": 2, "Number": 7, "$text": "1" }
        ] } }]
  }]
}
