<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture: v0125-orientation-270.xml
  Covers: Orientation="270" - the last quadrant the corpus was missing (0, 90,
          180 and the non-quadrant 45 were already present).
  Grid: 3 cols x 2 rows, all tokens distinct.
  Frame: LowerLeft / UpRight, so the logical mapping is the plain one and the
         fixture varies ONLY the orientation. Orientation is a PHYSICAL rotation
         of the placement, not a re-indexing: the logical<->serialization map is
         unchanged by it, which the probes below assert by being identical to
         what an orientation-0 document would give.
  Zero-cell: logical (0,0) is serialization (col 0, row 1).
-->
<MapData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:semi-org:xsd.E142-1.V0125.SubstrateMap E142-1-V0125-Schema.xsd"
    xmlns="urn:semi-org:xsd.E142-1.V0125.SubstrateMap">
  <Layouts>
    <Layout LayoutId="Orient270" DefaultUnits="mm" TopLevel="true">
      <Dimension X="3" Y="2"/>
      <StepSize X="2.0" Y="3.0" Units="mm"/>
    </Layout>
  </Layouts>
  <SubstrateMaps>
    <SubstrateMap SubstrateType="Wafer" SubstrateId="ORIENT270" LayoutSpecifier="Orient270"
        Orientation="270" OriginLocation="LowerLeft" AxisDirection="UpRight">
      <Overlay MapName="Sort" MapVersion="1">
        <BinCodeMap BinType="Ascii" NullBin="." MapType="2DArray">
          <BinCode>pqr</BinCode>
          <BinCode>stu</BinCode>
        </BinCodeMap>
      </Overlay>
    </SubstrateMap>
  </SubstrateMaps>
</MapData>
