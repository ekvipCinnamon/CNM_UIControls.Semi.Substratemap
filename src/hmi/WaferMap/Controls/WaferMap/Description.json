{
    "$schema": "../.hmiframework/Schema/ControlDescription.Schema.json",
    "apiVersion": 1,
    "name": "WaferMap",
    "namespace": "TcHmi.Controls.WaferMap",
    "displayName": "WaferMap",
    "version": {
        "full": "1.0.0.0",
        "major": 1,
        "minor": 0,
        "revision": 0,
        "build": 0
    },
    "visible": true,
    "themeable": "Standard",
    "base": "TcHmi.Controls.System.TcHmiControl",
    "description": "Renders a SEMI-standard wafer (flats or notch) and its dies. Wafer identity and die data are exposed as bindable attributes for MES / recipe data.",
    "properties": {
        "containerControl": false,
        "geometry": {
            "width": 150,
            "height": 150
        }
    },
    "icons": [
        {
            "name": "Icons/16x16.png",
            "width": 16,
            "height": 16
        }
    ],
    "template": "Template.html",
    "dependencyFiles": [
        {
            "name": "WaferMap.js",
            "type": "EsModule",
            "description": "Contains all the main logic."
        },
        {
            "name": "Style.css",
            "type": "Stylesheet",
            "description": "Theme independent style"
        }
    ],
    "themes": {
        "Base": {
            "resources": [
                {
                    "name": "Themes/Base/Style.css",
                    "type": "Stylesheet",
                    "description": "Theme dependent style"
                }
            ]
        },
        "Base-Dark": {
            "resources": [
                {
                    "name": "Themes/Base-Dark/Style.css",
                    "type": "Stylesheet",
                    "description": "Theme dependent style"
                }
            ]
        }
    },
    "attributes": [
        {
            "name": "data-tchmi-chips",
            "propertyName": "Chips",
            "propertySetterName": "setChips",
            "propertyGetterName": "getChips",
            "displayName": "Chips",
            "visible": true,
            "themeable": "None",
            "displayPriority": 10,
            "type": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipEntryList",
            "category": "Data",
            "description": "Full die layout (positions in meter x prefix, wafer-centric, +y up, origin = wafer center). Bind to an MES / database symbol. Overrides the demo grid when non-empty.",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": null
        },
        {
            "name": "data-tchmi-status-assignments",
            "propertyName": "StatusAssignments",
            "propertySetterName": "setStatusAssignments",
            "propertyGetterName": "getStatusAssignments",
            "displayName": "Status assignments",
            "visible": true,
            "themeable": "None",
            "displayPriority": 20,
            "type": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipStatusAssignmentList",
            "category": "Data",
            "description": "Per-chip status updates keyed by chips_id. Overrides the status embedded in Chips. Use for status-only refreshes without resending geometry.",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": null
        },
        {
            "name": "data-tchmi-wafer-type",
            "propertyName": "WaferType",
            "propertySetterName": "setWaferType",
            "propertyGetterName": "getWaferType",
            "displayName": "Wafer type",
            "visible": true,
            "themeable": "None",
            "displayPriority": 30,
            "type": "tchmi:general#/definitions/String",
            "category": "Wafer",
            "description": "Doping / orientation: P-111, N-111, P-100 or N-100. Ignored for sizes >= 8 inch (notch). Typically bound to an MES / recipe symbol.",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": "N-100"
        },
        {
            "name": "data-tchmi-wafer-size-inch",
            "propertyName": "WaferSizeInch",
            "propertySetterName": "setWaferSizeInch",
            "propertyGetterName": "getWaferSizeInch",
            "displayName": "Wafer size [inch]",
            "visible": true,
            "themeable": "None",
            "displayPriority": 40,
            "type": "tchmi:general#/definitions/Number",
            "category": "Wafer",
            "description": "Nominal wafer size in inch (2, 3, 4, 5, 6, 8, 12, 18). Snapped to the nearest known size. Typically bound to an MES / recipe symbol.",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": 4
        },
        {
            "name": "data-tchmi-secondary-flat-direction",
            "propertyName": "SecondaryFlatDirection",
            "propertySetterName": "setSecondaryFlatDirection",
            "propertyGetterName": "getSecondaryFlatDirection",
            "displayName": "Secondary flat direction",
            "visible": true,
            "themeable": "None",
            "displayPriority": 50,
            "type": "tchmi:general#/definitions/String",
            "category": "Wafer",
            "description": "Orientation convention for the secondary flat relative to the primary: 'cw' or 'ccw' (front/back view mirror each other).",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": "cw"
        },
        {
            "name": "data-tchmi-notch-exaggeration",
            "propertyName": "NotchExaggeration",
            "propertySetterName": "setNotchExaggeration",
            "propertyGetterName": "getNotchExaggeration",
            "displayName": "Notch exaggeration",
            "visible": true,
            "themeable": "None",
            "displayPriority": 60,
            "type": "tchmi:general#/definitions/Number",
            "category": "Appearance",
            "description": "Visual magnification of the true notch depth (1 = to scale, but practically invisible). Clamped to >= 1.",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": 12
        },
        {
            "name": "data-tchmi-show-demo-chips",
            "propertyName": "ShowDemoChips",
            "propertySetterName": "setShowDemoChips",
            "propertyGetterName": "getShowDemoChips",
            "displayName": "Show demo chips",
            "visible": true,
            "themeable": "None",
            "displayPriority": 70,
            "type": "tchmi:general#/definitions/Boolean",
            "category": "Appearance",
            "description": "Draw a random placeholder die grid (with random statuses) when no real Chips are bound. Useful at design time.",
            "readOnly": false,
            "bindable": true,
            "heritable": false,
            "defaultValue": null,
            "defaultValueInternal": true
        }
    ],
    "attributeCategories": [
        {
            "name": "Data",
            "displayName": "Data",
            "description": "Die layout and status, typically supplied by MES / database."
        },
        {
            "name": "Wafer",
            "displayName": "Wafer",
            "description": "Wafer identification, typically supplied by MES / recipe."
        },
        {
            "name": "Appearance",
            "displayName": "Appearance",
            "description": "Visual options."
        }
    ],
    "functions": [],
    "events": [],
    "dataTypes": [
        { "schema": "Schema/Types.Schema.json" },
        {
            "name": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.MetricPrefix",
            "schema": "Schema/TypeDefinitions/MetricPrefix.Schema.json"
        },
        {
            "name": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipStatus",
            "schema": "Schema/TypeDefinitions/ChipStatus.Schema.json"
        },
        {
            "name": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipEntry",
            "schema": "Schema/TypeDefinitions/ChipEntry.Schema.json"
        },
        {
            "name": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipEntryList",
            "schema": "Schema/TypeDefinitions/ChipEntryList.Schema.json"
        },
        {
            "name": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipStatusAssignment",
            "schema": "Schema/TypeDefinitions/ChipStatusAssignment.Schema.json"
        },
        {
            "name": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipStatusAssignmentList",
            "schema": "Schema/TypeDefinitions/ChipStatusAssignmentList.Schema.json"
        }
    ]
}
