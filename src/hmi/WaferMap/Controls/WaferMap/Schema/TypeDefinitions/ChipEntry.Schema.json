{
  "$schema": "http://json-schema.org/draft-04/schema",
  "definitions": {
    "TcHmi.Controls.WaferMap.ChipEntry": {
      "$schema": "http://json-schema.org/draft-04/schema",
      "title": "ChipEntry",
      "type": "object",
      "properties": {
        "chips_id": {
          "type": "integer",
          "description": "Primary key (optional)."
        },
        "device_substrates_id": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "description": "e.g. 46"
        },
        "center_position_x": {
          "type": "integer",
          "description": "Center X relative to average marker positions."
        },
        "center_position_y": {
          "type": "integer",
          "description": "Center Y relative to average marker positions."
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "exclusiveMinimum": true
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "exclusiveMinimum": true
        },
        "unit": {
          "type": "string",
          "enum": [
            "meter"
          ],
          "description": "Base unit for all spatial dimensions."
        },
        "prefix": {
          "$ref": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.MetricPrefix"
        },
        "status": {
          "$ref": "tchmi:framework#/definitions/TcHmi.Controls.WaferMap.ChipStatus"
        }
      },
      "required": [
        "device_substrates_id",
        "center_position_x",
        "center_position_y",
        "width",
        "length",
        "unit",
        "prefix"
      ],
      "additionalProperties": false
    }
  }
}